    "start_char": 2471,
    "end_char": 3622,
    "content": "def create_file(file_name: str, force: bool = False) -> Path:\n\n    file_path = Path(file_name)\n\n    if file_path.exists():\n        if not force:\n            print(f\"File '{file_name}' \"\n                  \"already exists, do you wish to replace it?\")\n            answer = input(\"Y for 'yes', any for 'no': \").strip().lower()\n            if answer != \"y\":\n                print(\"Stopping Program\")\n                raise FileExistsError(file_name)\n            print(\"Continuing...\")\n        if file_path.is_file():\n            file_path.unlink()\n        elif file_path.is_dir():\n            if not force:\n                print(f\"'{file_name}' \"\n                      \"is a directory are you SURE you wish to replace it?\")\n                answer = input(\"Y for 'yes', any for 'no': \").strip().lower()\n                if answer != \"y\":\n                    print(\"Stopping Program\")\n                    raise IsADirectoryError(file_path)\n            rmtree(file_path)\n        else:\n            raise ValueError(\"Unsupported path type\")\n\n    file_path.parent.mkdir(parents=True, exist_ok=True)\n    with file_path.open(\"x\"):\n        pass\n\n    return file_path",
